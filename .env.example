# ============================================================
#  .env.example — copie para .env e preencha os valores
#  NUNCA commite o arquivo .env real no git
# ============================================================

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=True

# Banco de dados PostgreSQL (local ou RDS)
# Para desenvolvimento local: aponte para o seu PostgreSQL instalado
# Para produção no EB: o EB injeta automaticamente as variáveis RDS_*
RDS_HOSTNAME=localhost
RDS_PORT=5432
RDS_DB_NAME=produtos_db
RDS_USERNAME=postgres
RDS_PASSWORD=123456

# S3 — deixe em branco para usar armazenamento local em desenvolvimento
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
